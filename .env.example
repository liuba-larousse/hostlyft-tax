# ============================================================================
#  Hostlyft Tax Tracker - secrets template
# ============================================================================
#
#  WHAT THIS FILE IS
#  A template. It contains the NAMES of every password and API key the project
#  needs, but none of the real values. It is safe to put on GitHub.
#
#  WHAT YOU ACTUALLY USE
#  A copy of this file at  tax/.env  with your real values filled in.
#  setup_mac.command makes that copy for you and locks it down so only your Mac
#  account can read it.
#
#  tax/.env is listed in .gitignore, which means git refuses to upload it.
#  Your real keys never leave this Mac.
#
#  FORMAT
#  One setting per line:  NAME=value
#  No spaces around the "=". No quotes needed. Lines starting with # are notes.
#
#  Leave a value blank if you haven't got it yet. Nothing breaks - the tools
#  that need it will say so clearly when you run them.
# ============================================================================


# ----------------------------------------------------------------------------
# STRIPE  (needed from Stage 4 - your invoice income)
# ----------------------------------------------------------------------------
# Where to get it:
#   dashboard.stripe.com -> Developers -> API keys -> "Secret key" -> Reveal
#
# Use the key starting with  sk_live_  for real data.
# A key starting with  sk_test_  only sees fake test transactions.
#
# This key can move real money. Treat it like your bank password.
STRIPE_SECRET_KEY=

# ----------------------------------------------------------------------------
# WISE  (needed from Stage 6 - your business account)
# ----------------------------------------------------------------------------
# Where to get the token:
#   wise.com -> your name (top right) -> Settings -> API tokens
#   -> Create token -> choose READ ONLY -> copy it
#
# Read-only is correct and important: this project only ever reads your
# transactions. It should never be able to send money.
WISE_API_TOKEN=

# Wise gives one login several "profiles" - separate accounts under the same
# sign-in. Each is named explicitly here rather than guessed, so the narrow
# read of the personal account can never point at the wrong one.
#
# The Hostlyft LLC business profile. Everything is read from this one:
# operating balances and the per-person jars.
WISE_PROFILE_ID=93461311

# The personal profile. Read NARROWLY - only incoming payments from Marcus,
# and nothing else. No personal spending is ever read, stored or logged.
WISE_PERSONAL_PROFILE_ID=17549462

# Wise blocks statement downloads unless each request is signed with a private
# key - a security rule called SCA (see PLAN.md, finding 1).
# Stage 6 creates that key for you and puts it here. Leave as-is for now.
WISE_PRIVATE_KEY_PATH=tax/wise_private_key.pem

# ----------------------------------------------------------------------------
# EMAIL REMINDERS  (needed from Stage 10 - quarterly tax deadlines, FBAR,
#                   and the $600 contractor alarm)
# ----------------------------------------------------------------------------
# The Gmail address the reminders are sent FROM and TO.
GMAIL_ADDRESS=help.hostlyft@gmail.com
ALERT_EMAIL_TO=help.hostlyft@gmail.com

# NOT your Gmail password. A 16-character "app password" - a one-purpose
# password you can revoke without changing your real one.
#
# Order matters: you must turn on 2-Step Verification FIRST, because the app
# password page does not exist until you do.
#   1. myaccount.google.com/security -> 2-Step Verification -> turn on
#   2. myaccount.google.com/apppasswords -> name it "Hostlyft Tax" -> Create
#   3. Paste the 16 characters here (spaces are fine, they get stripped)
#
# Stage 10 walks through this properly. Leave blank until then.
GMAIL_APP_PASSWORD=

# ----------------------------------------------------------------------------
# GOOGLE SHEET  (needed from Stage 11 - the reconciliation tabs)
# ----------------------------------------------------------------------------
# Your existing accounting sheet, Hostlyft_Accounting_2026.
#
# The ID is the long code in the sheet's own web address, between /d/ and /edit.
# This one is already filled in - change it only if you move to a new sheet.
GOOGLE_SHEET_ID=1KtqNg_hJFkceP7JRzFg_ru_7Q9jwmrrLbUz6UVUHJhg

# Hostlyft's Google Workspace blocks service-account keys by policy, so the
# tool signs in AS you instead, once, in a browser. See GOOGLE-SETUP.md.
#
# Two files live in tax/ and neither is set here - they are found by name:
#   google_oauth_client.json   downloaded from the Cloud console
#   google_token.json          written by scripts/google_login.py
#
# The sign-in asks for ONE permission: read and write Google Sheets. Not
# Drive, not documents, not photos. Withdraw it any time at
# myaccount.google.com/permissions

# The Drive folder holding the accounting sheet. The new tax sheet is
# created alongside it. Found automatically from the sheet, so leave blank.
GOOGLE_DRIVE_FOLDER_ID=
